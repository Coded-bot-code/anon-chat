<% title = `${mode.name} for ${profileUser.username}` %>
<%- include('partials/header') %>

<div class="auth-plain send-page">
  <% if (sent) { %>
    <div class="sent-confirmation">
      <div class="sent-icon">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/><path d="M8 12.5l2.5 2.5L16 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1 class="plain-title">Sent!</h1>
      <p class="plain-subtitle">Your anonymous message was delivered to <%= profileUser.display_name || profileUser.username %>.</p>
      <a href="<%= mode.path %>/<%= profileUser.username %>" class="btn-white btn-link-block">Send another</a>
    </div>
  <% } else { %>
    <% if (profileUser.profile_photo) { %>
      <img src="<%= profileUser.profile_photo %>" class="send-avatar" alt="<%= profileUser.username %>">
    <% } else { %>
      <div class="send-avatar send-avatar-fallback"><%= profileUser.username.charAt(0).toUpperCase() %></div>
    <% } %>

    <div class="mode-kicker"><%= mode.name %></div>
    <h1 class="plain-title"><%= prompt %></h1>
    <p class="plain-subtitle"><%= mode.description %><br>to <strong>@<%= profileUser.username %></strong> · fully anonymous</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="<%= mode.path %>/<%= profileUser.username %>" class="plain-form">
      <input type="hidden" name="prompt" value="<%= prompt %>">
      <div class="message-composer">
        <textarea id="message-body" name="body" rows="5" maxlength="1000" placeholder="Type your anonymous message..." required></textarea>
        <button type="button" id="random-prompt-btn" class="random-prompt-btn" title="Use a random prompt" aria-label="Use a random prompt">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none"><path d="m4 4 5 5m0-5-5 5M15 15l5 5m0-5-5 5M14 5h2a3 3 0 0 1 3 3v1M10 19H8a3 3 0 0 1-3-3v-1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
      <button type="submit" class="btn-white">Send Anonymously</button>
    </form>
  <% } %>

  <p class="powered-by-plain">Want your own anonymous link? <a href="/signup">Create an account</a></p>
</div>

<script>
  (() => {
    const prompts = <%- JSON.stringify(prompts || []) %>;
    const textarea = document.getElementById('message-body');
    const randomButton = document.getElementById('random-prompt-btn');
    if (!textarea || !randomButton || !prompts.length) return;

    let promptIndex = Math.floor(Math.random() * prompts.length);
    const updatePlaceholder = () => {
      textarea.placeholder = prompts[promptIndex];
      promptIndex = (promptIndex + 1) % prompts.length;
    };
    updatePlaceholder();
    randomButton.addEventListener('click', () => {
      const prompt = prompts[Math.floor(Math.random() * prompts.length)];
      textarea.value = prompt;
      textarea.focus();
      textarea.setSelectionRange(prompt.length, prompt.length);
    });
    setInterval(updatePlaceholder, 5000);
  })();
</script>

<%- include('partials/footer') %>
