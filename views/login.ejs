<% title = 'Log In' %>
<%- include('partials/header') %>

<div class="auth-plain">
  <a href="/" class="back-link">← Back</a>

  <h1 class="plain-title">Welcome back</h1>
  <p class="plain-subtitle">Log in to check your inbox.</p>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <form method="POST" action="/login" class="plain-form">
    <input type="text" name="username" placeholder="Username" autocomplete="username" required>
    <div class="password-input-wrapper">
  <input 
    type="password" 
    id="password" 
    name="password" 
    placeholder="Password" 
    autocomplete="current-password"
    required
  >
  <button 
    type="button" 
    class="toggle-password-btn" 
    onclick="togglePasswordVisibility('password', this)" 
    aria-label="Toggle password visibility"
  >
    <!-- Eye Open Icon (Default) -->
    <svg class="eye-icon" viewBox="0 0 24 24">
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
  </button>
</div>
    <button type="submit" class="btn-white">Log In</button>
  </form>

  <p class="switch-link-plain">Don't have an account? <a href="/signup">Sign up</a></p>
</div>

<%- include('partials/footer') %>
