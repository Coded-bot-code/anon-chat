<% title = 'Account Settings' %>
<%- include('partials/header') %>

<div class="app-shell">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" fill="url(#logoGradS)"/><defs><linearGradient id="logoGradS" x1="0" y1="0" x2="24" y2="17" gradientUnits="userSpaceOnUse"><stop stop-color="#6a5cff"/><stop offset="1" stop-color="#ff5ca8"/></linearGradient></defs></svg>
      <span>Anon Chat</span>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-item">
        <span class="nav-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none"><path d="M3 11.5 12 4l9 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        Home
      </a>
      <a href="/dashboard/inbox" class="nav-item">
        <span class="nav-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none"><path d="M3 8.5 12 14l9-5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/></svg></span>
        Inbox
      </a>
      <a href="/dashboard/settings" class="nav-item active">
        <span class="nav-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M19.4 13.5a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.9 2.9l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V20a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.9-2.9l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H4a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.9-2.9l.1.1a1.7 1.7 0 0 0 1.9.3H10a1.7 1.7 0 0 0 1-1.6V4a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.9 2.9l-.1.1a1.7 1.7 0 0 0-.3 1.9V10a1.7 1.7 0 0 0 1.6 1H20a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span>
        Settings
      </a>
    </nav>
    <div class="sidebar-user">
      <% if (profilePhoto) { %>
        <img src="<%= profilePhoto %>" class="sidebar-avatar" alt="<%= username %>">
      <% } else { %>
        <div class="sidebar-avatar sidebar-avatar-fallback"><%= username.charAt(0).toUpperCase() %></div>
      <% } %>
      <div class="sidebar-user-info">
        <div class="sidebar-user-name"><%= displayName || username %></div>
        <div class="sidebar-user-handle">@<%= username %></div>
      </div>
      <form method="POST" action="/logout">
        <button type="submit" class="icon-btn" title="Log out">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>
    </div>
  </aside>

  <main class="app-main">
    <div class="app-header-mobile">
      <div class="mobile-brand">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" fill="url(#logoGradSM)"/><defs><linearGradient id="logoGradSM" x1="0" y1="0" x2="24" y2="17" gradientUnits="userSpaceOnUse"><stop stop-color="#6a5cff"/><stop offset="1" stop-color="#ff5ca8"/></linearGradient></defs></svg>
        <span>Settings</span>
      </div>
      <div class="mobile-user-row">
        <a href="/dashboard" class="icon-btn-mobile" title="Back to dashboard">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <form method="POST" action="/logout">
          <button type="submit" class="icon-btn-mobile" title="Log out">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>
      </div>
    </div>

    <div class="settings-container">
      <div class="settings-header-bar">
        <a href="/dashboard" class="back-btn" title="Back to Dashboard">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div>
          <h1 class="panel-title settings-title">Settings</h1>
          <p class="panel-subtitle settings-subtitle">Manage your profile and security credentials</p>
        </div>
      </div>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <!-- PROFILE CARD -->
      <div class="settings-section-card">
        <div class="section-head">
          <h2>Profile Information</h2>
          <p>Tap your picture to change your profile photo.</p>
        </div>

        <form method="POST" action="/dashboard/settings/profile" enctype="multipart/form-data">
          <div class="avatar-upload-wrapper">
            <label class="avatar-picker-label" for="avatarInput" title="Tap to change avatar">
              <% if (profilePhoto) { %>
                <img src="<%= profilePhoto %>" id="avatarPreview" class="avatar-picker-img" alt="Avatar">
              <% } else { %>
                <div id="avatarFallback" class="avatar-picker-fallback"><%= username.charAt(0).toUpperCase() %></div>
              <% } %>
              <div class="avatar-overlay">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M4 8a2 2 0 0 1 2-2h1.2a1 1 0 0 0 .8-.4l.6-.8a1 1 0 0 1 .8-.4h5.2a1 1 0 0 1 .8.4l.6.8a1 1 0 0 0 .8.4H18a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8Z" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="13" r="3.2" stroke="#fff" stroke-width="1.6"/></svg>
                <span>Change</span>
              </div>
            </label>
            <input type="file" id="avatarInput" name="avatar" accept="image/*" class="hidden" onchange="previewAvatar(event)">

            <div class="avatar-help-text">
              <span><%= displayName || username %></span>
              <small>Click image to upload a new avatar</small>
            </div>
          </div>

          <div class="form-field">
            <label for="displayName">Display Name</label>
            <input type="text" id="displayName" name="displayName" class="input-styled" value="<%= displayName || username %>" required>
          </div>

          <button type="submit" class="btn-primary btn-small settings-submit">Save Profile</button>
        </form>
      </div>

      <!-- PASSWORD CARD -->
      <div class="settings-section-card">
        <div class="section-head">
          <h2>Security &amp; Password</h2>
          <p>Update your account password</p>
        </div>

        <form method="POST" action="/dashboard/settings/password">
          <div class="form-field">
            <label for="currentPassword">Current Password</label>
            <div class="password-input-wrapper">
              <input type="password" id="currentPassword" name="currentPassword" class="input-styled" required>
              <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('currentPassword', this)" aria-label="Toggle password visibility">
                <svg class="eye-icon" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </button>
            </div>
          </div>

          <div class="form-field">
            <label for="newPassword">New Password</label>
            <div class="password-input-wrapper">
              <input type="password" id="newPassword" name="newPassword" class="input-styled" minlength="6" required>
              <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('newPassword', this)" aria-label="Toggle password visibility">
                <svg class="eye-icon" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-primary btn-small settings-submit">Update Password</button>
        </form>
      </div>

      <!-- DELETE ACCOUNT CARD -->
      <div class="settings-section-card danger-zone">
        <div class="section-head">
          <h2>Delete Account</h2>
          <p>Permanently remove your profile and all messages.</p>
        </div>

        <form method="POST" action="/dashboard/settings/delete" onsubmit="return confirm('Are you sure? This cannot be undone.');">
          <button type="submit" class="msg-action msg-action-danger settings-delete-btn">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-9 0 1 12a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2l1-12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Delete Account</span>
          </button>
        </form>
      </div>
    </div>
  </main>

  <nav class="bottom-nav">
    <a href="/dashboard" class="nav-item">
      <span class="nav-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none"><path d="M3 11.5 12 4l9 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span>Home</span>
    </a>
    <a href="/dashboard/inbox" class="nav-item">
      <span class="nav-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none"><path d="M3 8.5 12 14l9-5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/></svg></span>
      <span>Inbox</span>
    </a>
    <a href="/dashboard/settings" class="nav-item active">
      <span class="nav-icon"><svg viewBox="0 0 24 24" width="19" height="19" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M19.4 13.5a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.9 2.9l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V20a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.9-2.9l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H4a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.9-2.9l.1.1a1.7 1.7 0 0 0 1.9.3H10a1.7 1.7 0 0 0 1-1.6V4a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.9 2.9l-.1.1a1.7 1.7 0 0 0-.3 1.9V10a1.7 1.7 0 0 0 1.6 1H20a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span>
      <span>Settings</span>
    </a>
  </nav>
</div>

<script>
  function previewAvatar(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function (e) {
      let img = document.getElementById('avatarPreview');
      const fallback = document.getElementById('avatarFallback');

      if (!img) {
        img = document.createElement('img');
        img.id = 'avatarPreview';
        img.className = 'avatar-picker-img';
        fallback.parentNode.insertBefore(img, fallback);
        fallback.remove();
      }

      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }
</script>

<%- include('partials/footer') %>
