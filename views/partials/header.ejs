<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
  >

  <!-- Primary Meta Tags -->
  <title><%= typeof title !== 'undefined' ? title : 'Anon Chat' %></title>

  <meta
    name="title"
    content="<%= typeof title !== 'undefined' ? title : 'Anon Chat' %>"
  >

  <meta
    name="description"
    content="<%= typeof description !== 'undefined' ? description : 'Send and receive anonymous messages privately and securely.' %>"
  >

  <meta
    name="keywords"
    content="anonymous messaging, anon chat, anonymous messages, secret messages, anonymous questions, private messaging"
  >

  <meta name="author" content="Anon Chat">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#6a5cff">

  <!-- Favicon & Icons -->
  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href="https://i.ibb.co/qYRhvLdM/upload-1786830387799.png"
  >

  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href="https://i.ibb.co/qYRhvLdM/upload-1786830387799.png"
  >

  <link
    rel="shortcut icon"
    href="https://i.ibb.co/qYRhvLdM/upload-1786830387799.png"
  >

  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="https://i.ibb.co/qYRhvLdM/upload-1786830387799.png"
  >

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">

  <!-- iOS Web App Support -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Anon Chat">

  <!-- Android / Mobile -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="format-detection" content="telephone=no">

  <!-- Open Graph / Facebook / WhatsApp / Discord -->
  <meta property="og:type" content="website">

  <meta
    property="og:site_name"
    content="Anon Chat"
  >

  <meta
    property="og:title"
    content="<%= typeof title !== 'undefined' ? title : 'Anon Chat' %>"
  >

  <meta
    property="og:description"
    content="<%= typeof description !== 'undefined' ? description : 'Send and receive anonymous messages privately and securely.' %>"
  >

  <meta
    property="og:image"
    content="https://i.ibb.co/qYRhvLdM/upload-1786830387799.png"
  >

  <meta
    property="og:image:secure_url"
    content="https://i.ibb.co/qYRhvLdM/upload-1786830387799.png"
  >

  <meta
    property="og:image:type"
    content="image/png"
  >

  <meta
    property="og:image:width"
    content="512"
  >

  <meta
    property="og:image:height"
    content="512"
  >

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">

  <meta
    name="twitter:title"
    content="<%= typeof title !== 'undefined' ? title : 'Anon Chat' %>"
  >

  <meta
    name="twitter:description"
    content="<%= typeof description !== 'undefined' ? description : 'Send and receive anonymous messages privately and securely.' %>"
  >

  <meta
    name="twitter:image"
    content="https://i.ibb.co/qYRhvLdM/upload-1786830387799.png"
  >

  <!-- Styles -->
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/main.js"></script>
</head>

<body>